# ---- Copiar como ".env" junto a manage.py y cambiar los valores ----
# Este archivo NO se sube a GitHub (está en .gitignore).

# Clave secreta: genera una nueva con
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=pega-aqui-la-clave-generada

# En el servidor SIEMPRE False. En tu PC puedes poner True.
DEBUG=False

# IP y/o dominio con que entras al panel, separados por coma (sin espacios)
ALLOWED_HOSTS=192.168.3.20,panel.tvnetlago.com

# Solo si usas dominio con HTTPS (si no, déjalo vacío)
CSRF_TRUSTED_ORIGINS=
HTTPS=False

# MariaDB / MySQL (si DB_NAME está vacío, se usa SQLite: db.sqlite3)
DB_NAME=tvnetlago
DB_USER=tvnet
DB_PASSWORD=pon-una-clave-larga
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (Celery)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
